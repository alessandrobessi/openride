{
	"name": "openride",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.26.1",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"sync": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"world:fetch": "tsx tools/osm/fetch-stelvio.ts",
		"world:fetch-buildings": "tsx tools/osm/fetch-buildings.ts",
		"world:fetch-dem": "tsx tools/elevation/fetch-dem.ts",
		"world:extract": "tsx tools/osm/extract-road.ts",
		"world:elevation": "tsx tools/elevation/sample-elevation.ts",
		"world:mesh": "tsx tools/world-builder/build-road-mesh.ts",
		"world:terrain": "tsx tools/terrain/build-terrain.ts",
		"world:scenery": "tsx tools/world-builder/build-scenery.ts",
		"world:manifest": "tsx tools/world-builder/build-manifest.ts",
		"world:build": "pnpm world:extract && pnpm world:elevation && pnpm world:mesh && pnpm world:terrain && pnpm world:scenery && pnpm world:manifest"
	},
	"devDependencies": {
		"@eslint/js": "^9.17.0",
		"@playwright/test": "^1.49.1",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.15.1",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@types/node": "^22.10.5",
		"@types/three": "^0.171.0",
		"eslint": "^9.17.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.46.1",
		"geotiff": "^2.1.3",
		"globals": "^15.14.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.2",
		"svelte": "^5.16.1",
		"svelte-check": "^4.1.1",
		"tsx": "^4.23.13",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.19.0",
		"vite": "^6.0.7",
		"vitest": "^3.0.5"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"dependencies": {
		"@dimforge/rapier3d-compat": "^0.14.0",
		"three": "^0.171.0"
	}
}
